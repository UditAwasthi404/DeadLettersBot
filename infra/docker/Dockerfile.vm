FROM ubuntu:22.04 AS file-tools-build

# CA certs over HTTP first, then switch mirrors to HTTPS (HTTP apt often fails on Docker Desktop).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && sed -i 's|http://|https://|g' /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null || true \
 && apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*
COPY agentos-file.c /tmp/agentos-file.c
COPY agentos-shell.c /tmp/agentos-shell.c
RUN gcc -std=c11 -O2 -Wall -Wextra -Werror -o /usr/local/bin/agentos-file /tmp/agentos-file.c \
    && gcc -std=c11 -O2 -Wall -Wextra -Werror -o /usr/local/bin/agentos-shell /tmp/agentos-shell.c

FROM ubuntu:22.04

ARG PLAYWRIGHT_VERSION=1.64.1
ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/agent \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Install CA certs over HTTP first, then prefer HTTPS mirrors (HTTP apt often fails in Docker Desktop).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && sed -i 's|http://|https://|g' /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null || true \
 && apt-get update && apt-get install -y --no-install-recommends \
      bash coreutils findutils util-linux curl gpg inotify-tools iptables \
      x11vnc xdotool xvfb x11-utils x11-xserver-utils openbox tint2 xterm \
      fonts-dejavu-core fonts-liberation fonts-noto-core fonts-noto-color-emoji \
      fonts-jetbrains-mono dbus-x11 \
    && (apt-get install -y --no-install-recommends fonts-inter || true) \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && chmod 0644 /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install --global "playwright@${PLAYWRIGHT_VERSION}" "ipaddr.js@2.5.0" \
    && playwright install --with-deps chromium \
    && mkdir -p /usr/local/lib/agentos/node_modules \
    && ln -s "$(npm root --global)/ipaddr.js" /usr/local/lib/agentos/node_modules/ipaddr.js \
    && useradd --create-home --uid 1000 --shell /bin/bash agent \
    && mkdir -p /home/agent/Downloads /tmp/.X11-unix \
    && chown -R agent:agent /home/agent \
    && chmod 1777 /tmp/.X11-unix \
    && browser="$(find /ms-playwright -type f -name chrome -print -quit)" \
    && test -n "$browser" \
    && ln -s "$browser" /usr/local/bin/chromium \
    && chmod -R a+rX /ms-playwright \
    && rm -rf /var/lib/apt/lists/* /root/.npm/_logs

COPY agentos-tint2rc /etc/agentos/tint2rc
COPY chromium-initial-preferences.json /etc/agentos/chromium-initial-preferences.json
COPY ensure-bot-browser.sh /usr/local/bin/agentos-ensure-browser
COPY ensure-bot-vnc.sh /usr/local/bin/agentos-ensure-vnc
COPY agentos-pointer.sh /usr/local/bin/agentos-pointer
COPY agentos-desktop-focus.sh /usr/local/bin/agentos-desktop-focus
COPY controlled-exec.sh /usr/local/bin/agentos-controlled-exec
COPY agentos-vm-entrypoint.mjs /usr/local/bin/agentos-vm-entrypoint.mjs
COPY agentos-vm-entrypoint.sh /usr/local/bin/agentos-vm-entrypoint.sh
COPY --from=file-tools-build /usr/local/bin/agentos-file /usr/local/bin/agentos-file
COPY --from=file-tools-build /usr/local/bin/agentos-shell /usr/local/bin/agentos-shell
RUN chmod 0755 /usr/local/bin/agentos-ensure-browser /usr/local/bin/agentos-ensure-vnc /usr/local/bin/agentos-pointer /usr/local/bin/agentos-desktop-focus /usr/local/bin/agentos-controlled-exec /usr/local/bin/agentos-vm-entrypoint.mjs /usr/local/bin/agentos-vm-entrypoint.sh /usr/local/bin/agentos-file /usr/local/bin/agentos-shell \
    && node --version \
    && npm --version \
    && chromium --version

HEALTHCHECK --interval=1s --timeout=12s --start-period=30s --retries=60 CMD ["node", "-e", "if (process.env.AGENTOS_EGRESS_FIREWALL_HELPER === '1') { const fs = require('node:fs'); const cp = require('node:child_process'); const closeEgress = () => { for (const bin of ['iptables', 'ip6tables']) cp.spawnSync(bin, ['-w', '5', '-F', 'AGENTOS_EGRESS']); process.exit(1); }; try { const [pidText, heartbeatText, dueText] = fs.readFileSync('/run/agentos-egress-ready', 'utf8').split(':'); const pid = Number(pidText); const heartbeat = Number(heartbeatText); const due = Number(dueText); const cmd = fs.readFileSync('/proc/' + pid + '/cmdline', 'utf8'); const rules = JSON.parse(process.env.VM_EGRESS_ALLOWLIST || '[]'); const hasDomains = rules.some((rule) => typeof rule.domain === 'string'); if (!cmd.includes('/usr/local/bin/agentos-vm-entrypoint.mjs') || !Number.isFinite(heartbeat) || (hasDomains && (!Number.isFinite(due) || Date.now() > due + 10000))) closeEgress(); } catch { closeEgress(); } }"]

USER agent
WORKDIR /home/agent
ENTRYPOINT ["/usr/local/bin/agentos-vm-entrypoint.sh"]
CMD ["sleep", "infinity"]
