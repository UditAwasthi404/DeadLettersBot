FROM node:22-bookworm-slim AS node-runtime

FROM gcc:12-bookworm AS file-tools-build
COPY agentos-file.c /tmp/agentos-file.c
COPY agentos-shell.c /tmp/agentos-shell.c
RUN gcc -std=c11 -O2 -Wall -Wextra -Werror -o /usr/local/bin/agentos-file /tmp/agentos-file.c \
    && gcc -std=c11 -O2 -Wall -Wextra -Werror -o /usr/local/bin/agentos-shell /tmp/agentos-shell.c

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends chromium xvfb x11vnc bash coreutils findutils util-linux ca-certificates inotify-tools \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /tmp/.X11-unix \
    && chmod 1777 /tmp/.X11-unix \
    && useradd -m -u 1000 agent
ENV HOME=/home/agent

COPY ensure-bot-browser.sh /usr/local/bin/agentos-ensure-browser
COPY ensure-bot-vnc.sh /usr/local/bin/agentos-ensure-vnc
COPY controlled-exec.sh /usr/local/bin/agentos-controlled-exec
COPY --from=file-tools-build /usr/local/bin/agentos-file /usr/local/bin/agentos-file
COPY --from=file-tools-build /usr/local/bin/agentos-shell /usr/local/bin/agentos-shell
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN chmod 0755 /usr/local/bin/agentos-ensure-browser /usr/local/bin/agentos-ensure-vnc /usr/local/bin/agentos-controlled-exec /usr/local/bin/agentos-file /usr/local/bin/agentos-shell \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
RUN node --version && npm --version

USER agent
WORKDIR /home/agent
CMD ["sleep", "infinity"]
