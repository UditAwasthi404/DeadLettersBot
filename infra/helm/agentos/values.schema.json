{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 2 },
        "maxReplicas": { "type": "integer", "minimum": 2 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "properties": {
        "vmEgressPolicy": {
          "type": "string",
          "enum": ["allow_all", "deny_all", "allowlist"]
        },
        "vmEgressAllowlist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cidr", "ports"],
            "properties": {
              "cidr": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["port"],
                  "properties": {
                    "protocol": { "type": "string", "enum": ["TCP", "UDP", "SCTP"] },
                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "vmMemoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "vmCpuNanos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "if": { "properties": { "vmEgressPolicy": { "const": "allowlist" } } },
      "then": {
        "required": ["vmEgressAllowlist"],
        "properties": { "vmEgressAllowlist": { "minItems": 1 } }
      },
      "additionalProperties": true
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "ingressNamespaceSelector": { "minProperties": 1 }
        }
      },
      "additionalProperties": true
    },
    "vmManager": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
            "pullSecret": { "type": "string" }
          },
          "additionalProperties": true
        },
        "storageSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "storageClassName": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
