{
  "title": "AgentOS latency overview",
  "uid": "agentos-overview",
  "description": "shortcut: dashboard JSON is hand-authored; upgrade to generated when benchmark data is available.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Turn duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "agentos-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(turn_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 2,
      "title": "Step duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "agentos-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(step_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Inference duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "agentos-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(inference_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tool duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "agentos-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tool_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "title": "Active turns",
      "type": "stat",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "agentos-prometheus" },
      "targets": [{ "expr": "active_turns", "legendFormat": "running" }]
    }
  ]
}
