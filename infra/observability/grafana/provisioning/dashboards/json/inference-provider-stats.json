{
  "title": "AgentOS Inference Provider Stats",
  "uid": "agentos-inference",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Inference request rate by provider",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (provider) (rate(agentos_inference_request_duration_seconds_count[5m]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Inference latency p50 / p95 / p99 (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(agentos_inference_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}} p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(agentos_inference_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}} p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, provider) (rate(agentos_inference_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}} p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory extraction p95 (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agentos_memory_extraction_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
